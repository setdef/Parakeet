<templateSet group="Inko">
  <template name="fn" value="fn $NAME$ {&#10;  $END$&#10;}" description="Method" toReformat="false" toShortenFQNames="false">
    <variable name="NAME" expression="" defaultValue="&quot;name&quot;" alwaysStopAt="true"/>
    <context><option name="INKO" value="true"/></context>
  </template>
  <template name="fnp" value="fn pub $NAME$ {&#10;  $END$&#10;}" description="Public method" toReformat="false" toShortenFQNames="false">
    <variable name="NAME" expression="" defaultValue="&quot;name&quot;" alwaysStopAt="true"/>
    <context><option name="INKO" value="true"/></context>
  </template>
  <template name="type" value="type $NAME$ {&#10;  $END$&#10;}" description="Type" toReformat="false" toShortenFQNames="false">
    <variable name="NAME" expression="" defaultValue="&quot;Name&quot;" alwaysStopAt="true"/>
    <context><option name="INKO" value="true"/></context>
  </template>
  <template name="typep" value="type pub $NAME$ {&#10;  $END$&#10;}" description="Public type" toReformat="false" toShortenFQNames="false">
    <variable name="NAME" expression="" defaultValue="&quot;Name&quot;" alwaysStopAt="true"/>
    <context><option name="INKO" value="true"/></context>
  </template>
  <template name="trait" value="trait pub $NAME$ {&#10;  $END$&#10;}" description="Public trait" toReformat="false" toShortenFQNames="false">
    <variable name="NAME" expression="" defaultValue="&quot;Name&quot;" alwaysStopAt="true"/>
    <context><option name="INKO" value="true"/></context>
  </template>
  <template name="impl" value="impl $TRAIT$ for $TYPE$ {&#10;  $END$&#10;}" description="Trait implementation" toReformat="false" toShortenFQNames="false">
    <variable name="TRAIT" expression="" defaultValue="&quot;Trait&quot;" alwaysStopAt="true"/>
    <variable name="TYPE" expression="" defaultValue="&quot;Type&quot;" alwaysStopAt="true"/>
    <context><option name="INKO" value="true"/></context>
  </template>
  <template name="match" value="match $VALUE$ {&#10;  case $PATTERN$ -&gt; $END$&#10;}" description="Pattern match" toReformat="false" toShortenFQNames="false">
    <variable name="VALUE" expression="" defaultValue="&quot;value&quot;" alwaysStopAt="true"/>
    <variable name="PATTERN" expression="" defaultValue="&quot;_&quot;" alwaysStopAt="true"/>
    <context><option name="INKO" value="true"/></context>
  </template>
  <template name="main" value="type async Main {&#10;  fn async main {&#10;    $END$&#10;  }&#10;}" description="Program entry point" toReformat="false" toShortenFQNames="false">
    <context><option name="INKO" value="true"/></context>
  </template>
  <template name="tests" value="fn pub tests(t: mut Tests) {&#10;  $END$&#10;}" description="Test file entry point (needs: import std.test (Tests))" toReformat="false" toShortenFQNames="false">
    <context><option name="INKO" value="true"/></context>
  </template>
  <template name="test" value="t.test('$NAME$', fn (t) {&#10;  $END$&#10;})" description="Test" toReformat="false" toShortenFQNames="false">
    <variable name="NAME" expression="" defaultValue="&quot;does something&quot;" alwaysStopAt="true"/>
    <context><option name="INKO" value="true"/></context>
  </template>
  <template name="surround_if" value="if $CONDITION$ {&#10;  $SELECTION$&#10;}" description="Surround with if" toReformat="false" toShortenFQNames="false">
    <variable name="CONDITION" expression="" defaultValue="" alwaysStopAt="true"/>
    <context><option name="INKO" value="true"/></context>
  </template>
  <template name="surround_if_else" value="if $CONDITION$ {&#10;  $SELECTION$&#10;} else {&#10;  $END$&#10;}" description="Surround with if / else" toReformat="false" toShortenFQNames="false">
    <variable name="CONDITION" expression="" defaultValue="" alwaysStopAt="true"/>
    <context><option name="INKO" value="true"/></context>
  </template>
  <template name="surround_if_not" value="if !$CONDITION$ {&#10;  $SELECTION$&#10;}" description="Surround with if !" toReformat="false" toShortenFQNames="false">
    <variable name="CONDITION" expression="" defaultValue="" alwaysStopAt="true"/>
    <context><option name="INKO" value="true"/></context>
  </template>
  <template name="surround_while" value="while $CONDITION$ {&#10;  $SELECTION$&#10;}" description="Surround with while" toReformat="false" toShortenFQNames="false">
    <variable name="CONDITION" expression="" defaultValue="" alwaysStopAt="true"/>
    <context><option name="INKO" value="true"/></context>
  </template>
  <template name="surround_loop" value="loop {&#10;  $SELECTION$$END$&#10;}" description="Surround with loop" toReformat="false" toShortenFQNames="false">
    <context><option name="INKO" value="true"/></context>
  </template>
  <template name="surround_for" value="for $NAME$ in $ITERABLE$ {&#10;  $SELECTION$&#10;}" description="Surround with for … in" toReformat="false" toShortenFQNames="false">
    <variable name="NAME" expression="" defaultValue="&quot;item&quot;" alwaysStopAt="true"/>
    <variable name="ITERABLE" expression="" defaultValue="" alwaysStopAt="true"/>
    <context><option name="INKO" value="true"/></context>
  </template>
  <template name="surround_match" value="match $VALUE$ {&#10;  case _ -&gt; {&#10;    $SELECTION$&#10;  }&#10;}" description="Surround with match" toReformat="false" toShortenFQNames="false">
    <variable name="VALUE" expression="" defaultValue="" alwaysStopAt="true"/>
    <context><option name="INKO" value="true"/></context>
  </template>
  <template name="surround_closure" value="fn {&#10;  $SELECTION$$END$&#10;}" description="Surround with closure (fn { … })" toReformat="false" toShortenFQNames="false">
    <context><option name="INKO" value="true"/></context>
  </template>
  <template name="surround_recover" value="recover {&#10;  $SELECTION$$END$&#10;}" description="Surround with recover { … }" toReformat="false" toShortenFQNames="false">
    <context><option name="INKO" value="true"/></context>
  </template>
  <template name="surround_block" value="{&#10;  $SELECTION$$END$&#10;}" description="Surround with block { … }" toReformat="false" toShortenFQNames="false">
    <context><option name="INKO" value="true"/></context>
  </template>
  <template name="surround_parentheses" value="($SELECTION$)$END$" description="Surround with ( … )" toReformat="false" toShortenFQNames="false">
    <context><option name="INKO" value="true"/></context>
  </template>
</templateSet>
