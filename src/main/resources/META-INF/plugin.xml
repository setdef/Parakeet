<idea-plugin>
    <id>com.setdef.parakeet</id>
    <name>Parakeet for Inko</name>
    <vendor email="kerrick@setdef.com" url="https://setdef.com">setdef</vendor>
    <description><![CDATA[
        <p>Parakeet is unofficial, community-made support for the <a href="https://inko-lang.org">Inko</a> programming language.</p>
        <ul>
            <li>Syntax highlighting for <code>.inko</code> files</li>
            <li>Line comment toggling (<code>#</code>)</li>
            <li>Bracket matching, auto-closing pairs, and surrounding pairs</li>
            <li>Two-space indentation as you type, like <code>inko fmt</code></li>
            <li>Compiler errors and warnings as you type, from <code>inko check</code>, with quick fixes: auto-import, fixes for unused imports, locals, and results, missing fields, methods, and traits, and unreachable code</li>
            <li>Inspections for Inko's style guide: naming, Bool methods ending in <code>?</code>, redundant argument names, and empty parentheses</li>
            <li>Reformat Code (and format on save) with <code>inko fmt</code></li>
            <li>Go to definition, quick documentation, Go to Class/Symbol, and completion, using the definitions <code>inko doc</code> reports, plus local variables and parameters</li>
            <li>Find Usages and Rename across the project, and highlight usages</li>
            <li>Parameter info, parameter-name hints, trait gutter icons, Go to Implementation and Super Method, and Implement/Override Methods</li>
            <li>Go to Test and Create Test</li>
            <li>Optimize Imports, removing unused imports and sorting the rest</li>
            <li>Introduce and Inline Variable, Safe Delete, and moving files and renaming directories with their imports updated</li>
            <li>Type and Call Hierarchies, and usage counts</li>
            <li>Surround With, Unwrap/Remove, Move Statement, Complete Current Statement, Extend Selection, and Copy Reference</li>
            <li>New Inko File templates, and standard library docs on docs.inko-lang.org (Shift+F1)</li>
            <li>The standard library and dependencies under External Libraries</li>
            <li><code>inko.pkg</code> highlighting and errors, and syncing, updating, adding, and removing dependencies</li>
            <li>Structure view, breadcrumbs, and code folding</li>
            <li>Live templates, postfix completion, TODO highlighting, and spell checking</li>
            <li>Run and test from the gutter, with run configurations for <code>inko run</code>, <code>test</code>, <code>build</code>, and <code>check</code>, with release builds, other targets, and static linking, and a test runner that reruns failed tests</li>
            <li>New Project wizard using <code>inko init</code></li>
            <li>Per-project toolchain: <code>inko</code> on PATH, ivm's default, or any ivm-installed version, with banners when Inko is missing or older than <code>inko.pkg</code> requires</li>
        </ul>
        <p>Requires the <code>inko</code> executable, found on <code>PATH</code>, in ivm's install
        directory, or chosen per project in <i>Settings | Languages &amp; Frameworks | Inko</i>.</p>
        <p>Uses the TextMate grammar and language configuration from
        <a href="https://github.com/inko-lang/vscode">inko-lang/vscode</a> (MPL-2.0).
        This plugin is not affiliated with or endorsed by the Inko project; please report problems
        <a href="https://github.com/setdef/Parakeet/issues">to Parakeet</a>, not to Inko.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.textmate</depends>
    <depends optional="true" config-file="parakeet-spellchecker.xml">com.intellij.modules.spellchecker</depends>

    <extensions defaultExtensionNs="com.intellij">
        <textmate.bundleProvider implementation="com.setdef.parakeet.InkoBundleProvider"/>

        <fileType name="Inko" implementationClass="com.setdef.parakeet.InkoFileType" fieldName="INSTANCE"
                  language="Inko" extensions="inko"/>
        <lang.parserDefinition language="Inko" implementationClass="com.setdef.parakeet.InkoParserDefinition"/>
        <!-- Colors come from the Inko TextMate grammar; its tokens need TextMate's editor highlighter too. -->
        <lang.syntaxHighlighterFactory language="Inko"
                                       implementationClass="org.jetbrains.plugins.textmate.language.syntax.highlighting.TextMateSyntaxHighlighterFactory"/>
        <editorHighlighterProvider filetype="Inko"
                                   implementationClass="org.jetbrains.plugins.textmate.language.syntax.highlighting.TextMateEditorHighlighterProvider"/>
        <lang.commenter language="Inko" implementationClass="com.setdef.parakeet.InkoCommenter"/>
        <lang.braceMatcher language="Inko" implementationClass="com.setdef.parakeet.InkoBraceMatcher"/>
        <lang.quoteHandler language="Inko" implementationClass="com.setdef.parakeet.InkoQuoteHandler"/>
        <langCodeStyleSettingsProvider implementation="com.setdef.parakeet.InkoCodeStyleSettingsProvider"/>
        <lineIndentProvider implementation="com.setdef.parakeet.InkoLineIndentProvider"/>
        <typedHandler implementation="com.setdef.parakeet.InkoClosingBracketTypedHandler"/>
        <lang.psiStructureViewFactory language="Inko" implementationClass="com.setdef.parakeet.InkoStructureViewFactory"/>
        <breadcrumbsInfoProvider implementation="com.setdef.parakeet.InkoBreadcrumbsProvider"/>
        <lang.foldingBuilder language="Inko" implementationClass="com.setdef.parakeet.InkoFoldingBuilder"/>
        <completion.contributor language="Inko" implementationClass="com.setdef.parakeet.InkoCompletionContributor"/>
        <typedHandler implementation="com.setdef.parakeet.InkoCompletionAutoPopup"/>
        <liveTemplateContext contextId="INKO" implementation="com.setdef.parakeet.InkoTemplateContextType"/>
        <defaultLiveTemplates file="/liveTemplates/Inko.xml"/>
        <indexPatternBuilder implementation="com.setdef.parakeet.InkoIndexPatternBuilder"/>
        <todoIndexer filetype="Inko" implementationClass="com.setdef.parakeet.InkoTodoIndexer"/>

        <projectService serviceInterface="com.setdef.parakeet.InkoCli" serviceImplementation="com.setdef.parakeet.InkoProjectCli"/>
        <applicationService serviceInterface="com.setdef.parakeet.IvmCli" serviceImplementation="com.setdef.parakeet.IvmProcessCli"/>
        <editorNotificationProvider implementation="com.setdef.parakeet.InkoMissingBanner"/>
        <editorNotificationProvider implementation="com.setdef.parakeet.InkoRequiredVersionBanner"/>

        <externalAnnotator language="Inko" implementationClass="com.setdef.parakeet.InkoCheckAnnotator"/>

        <!-- Inko's style guide, for what inko fmt doesn't fix. Weak warnings, like the IDE's own naming checks. -->
        <localInspection language="Inko" shortName="InkoNaming" displayName="Name doesn't follow the style guide"
                         groupName="Inko" enabledByDefault="true" level="WEAK WARNING"
                         implementationClass="com.setdef.parakeet.InkoNamingInspection"/>
        <localInspection language="Inko" shortName="InkoBooleanMethodName" displayName="Bool method name doesn't end in ?"
                         groupName="Inko" enabledByDefault="true" level="WEAK WARNING"
                         implementationClass="com.setdef.parakeet.InkoBooleanMethodNameInspection"/>
        <localInspection language="Inko" shortName="InkoRedundantNamedArgument" displayName="Redundant argument name"
                         groupName="Inko" enabledByDefault="true" level="WEAK WARNING"
                         implementationClass="com.setdef.parakeet.InkoRedundantNamedArgumentInspection"/>
        <localInspection language="Inko" shortName="InkoEmptyParentheses" displayName="Parentheses in a call without arguments"
                         groupName="Inko" enabledByDefault="true" level="WEAK WARNING"
                         implementationClass="com.setdef.parakeet.InkoEmptyParenthesesInspection"/>
        <codeInsight.template.postfixTemplateProvider language="Inko" implementationClass="com.setdef.parakeet.InkoPostfixTemplateProvider"/>
        <renamePsiElementProcessor implementation="com.setdef.parakeet.InkoDirectoryRenameProcessor" order="first"/>
        <qualifiedNameProvider implementation="com.setdef.parakeet.InkoQualifiedNameProvider"/>
        <lang.unwrapDescriptor language="Inko" implementationClass="com.setdef.parakeet.InkoUnwrapDescriptor"/>
        <extendWordSelectionHandler implementation="com.setdef.parakeet.InkoExtendSelectionHandler"/>
        <testFinder implementation="com.setdef.parakeet.InkoTestFinder"/>
        <testCreator language="Inko" implementationClass="com.setdef.parakeet.InkoTestCreator"/>
        <definitionsScopedSearch implementation="com.setdef.parakeet.InkoImplementationsSearch"/>
        <codeInsight.gotoSuper language="Inko" implementationClass="com.setdef.parakeet.InkoGotoSuperHandler"/>
        <codeInsight.implementMethod language="Inko" implementationClass="com.setdef.parakeet.InkoImplementMethodsHandler"/>
        <codeInsight.overrideMethod language="Inko" implementationClass="com.setdef.parakeet.InkoOverrideMethodsHandler"/>
        <lang.inspectionSuppressor language="Inko" implementationClass="com.setdef.parakeet.InkoInspectionSuppressor"/>
        <formattingService implementation="com.setdef.parakeet.InkoFormattingService"/>
        <platform.backend.documentation.psiTargetProvider implementation="com.setdef.parakeet.InkoDocumentationTargetProvider"/>
        <gotoClassContributor implementation="com.setdef.parakeet.InkoGotoClassContributor"/>
        <gotoSymbolContributor implementation="com.setdef.parakeet.InkoGotoSymbolContributor"/>
        <postStartupActivity implementation="com.setdef.parakeet.InkoIndexOnStartup"/>

        <configurationType implementation="com.setdef.parakeet.InkoRunConfigurationType"/>
        <runConfigurationProducer implementation="com.setdef.parakeet.InkoRunConfigurationProducer"/>
        <codeInsight.parameterInfo language="Inko" implementationClass="com.setdef.parakeet.InkoParameterInfoHandler"/>
        <codeInsight.declarativeInlayProvider language="Inko"
                                              implementationClass="com.setdef.parakeet.InkoParameterHintsProvider"
                                              isEnabledByDefault="true" group="PARAMETERS_GROUP"
                                              providerId="parakeet.inko.parameters" bundle="messages.ParakeetBundle"
                                              nameKey="inlay.parameters.name" descriptionKey="inlay.parameters.description"/>
        <fileType name="Inko Package Manifest" implementationClass="com.setdef.parakeet.InkoManifestFileType" fieldName="INSTANCE"
                  language="InkoManifest" fileNames="inko.pkg"/>
        <lang.parserDefinition language="InkoManifest" implementationClass="com.setdef.parakeet.InkoManifestParserDefinition"/>
        <lang.syntaxHighlighterFactory language="InkoManifest" implementationClass="com.setdef.parakeet.InkoManifestHighlighterFactory"/>
        <lang.commenter language="InkoManifest" implementationClass="com.setdef.parakeet.InkoManifestCommenter"/>
        <annotator language="InkoManifest" implementationClass="com.setdef.parakeet.InkoManifestAnnotator"/>
        <editorFloatingToolbarProvider implementation="com.setdef.parakeet.InkoManifestFloatingToolbarProvider"/>
        <editorNotificationProvider implementation="com.setdef.parakeet.InkoDependenciesBanner"/>
        <additionalLibraryRootsProvider implementation="com.setdef.parakeet.InkoLibraryRootsProvider"/>
        <lang.importOptimizer language="Inko" implementationClass="com.setdef.parakeet.InkoImportOptimizer"/>
        <inlineActionHandler implementation="com.setdef.parakeet.InkoInlineVariableHandler"/>
        <inlineActionHandler implementation="com.setdef.parakeet.InkoInlineMethodHandler"/>
        <typeHierarchyProvider language="Inko" implementationClass="com.setdef.parakeet.InkoTypeHierarchyProvider"/>
        <moveFileHandler implementation="com.setdef.parakeet.InkoMoveFileHandler"/>
        <statementUpDownMover implementation="com.setdef.parakeet.InkoStatementMover"/>
        <lang.smartEnterProcessor language="Inko" implementationClass="com.setdef.parakeet.InkoSmartEnterProcessor"/>
        <callHierarchyProvider language="Inko" implementationClass="com.setdef.parakeet.InkoCallHierarchyProvider"/>
        <codeInsight.daemonBoundCodeVisionProvider implementation="com.setdef.parakeet.InkoUsagesCodeVisionProvider"/>
        <internalFileTemplate name="Inko Module"/>
        <internalFileTemplate name="Inko Test"/>
        <internalFileTemplate name="Inko Program"/>
        <lang.findUsagesProvider language="Inko" implementationClass="com.setdef.parakeet.InkoFindUsagesProvider"/>
        <referencesSearch implementation="com.setdef.parakeet.InkoModuleReferencesSearcher"/>
        <usageTypeProvider implementation="com.setdef.parakeet.InkoUsageTypeProvider"/>
        <lang.namesValidator language="Inko" implementationClass="com.setdef.parakeet.InkoNamesValidator"/>
        <renameInputValidator implementation="com.setdef.parakeet.InkoRenameInputValidator"/>
        <renamePsiElementProcessor implementation="com.setdef.parakeet.InkoInstanceMethodRenameProcessor" order="first"/>
        <vetoRenameCondition implementation="com.setdef.parakeet.InkoRenameVeto"/>
        <lang.refactoringSupport language="Inko" implementationClass="com.setdef.parakeet.InkoRefactoringSupportProvider"/>
        <highlightUsagesHandlerFactory implementation="com.setdef.parakeet.InkoHighlightUsagesHandlerFactory"/>
        <errorHandler implementation="com.setdef.parakeet.InkoErrorReportSubmitter"/>
        <codeInsight.lineMarkerProvider language="Inko" implementationClass="com.setdef.parakeet.InkoTraitLineMarkerProvider"/>
        <runLineMarkerContributor language="Inko" implementationClass="com.setdef.parakeet.InkoRunLineMarkerContributor"/>

        <newProjectWizard.generator implementation="com.setdef.parakeet.InkoNewProjectWizard"/>
        <directoryProjectGenerator implementation="com.setdef.parakeet.InkoDirectoryProjectGenerator"/>

        <notificationGroup id="Parakeet for Inko" displayType="BALLOON"/>
        <projectConfigurable parentId="language" id="com.setdef.parakeet.settings" displayName="Inko"
                             instance="com.setdef.parakeet.InkoConfigurable"/>
    </extensions>

    <actions>
        <group id="Parakeet.InkoDependencies" text="Inko Dependencies" popup="true" icon="com.setdef.parakeet.InkoIcons.FILE">
            <action id="Parakeet.SyncDependencies" class="com.setdef.parakeet.InkoSyncDependenciesAction"
                    text="Sync Dependencies" description="Download and install inko.pkg's dependencies (inko pkg sync)"
                    icon="AllIcons.Actions.BuildLoadChanges"/>
            <action id="Parakeet.UpdateDependencies" class="com.setdef.parakeet.InkoUpdateDependenciesAction"
                    text="Update Dependencies" description="Update dependencies to their newest compatible versions (inko pkg update), then sync"/>
            <action id="Parakeet.AddDependency" class="com.setdef.parakeet.InkoAddDependencyAction"
                    text="Add Dependency…" description="Add a dependency to inko.pkg (inko pkg add), then sync"/>
            <action id="Parakeet.RemoveDependency" class="com.setdef.parakeet.InkoRemoveDependencyAction"
                    text="Remove Dependency…" description="Remove a dependency from inko.pkg (inko pkg remove), then sync"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </group>
        <action id="Parakeet.NewInkoFile" class="com.setdef.parakeet.InkoNewFileAction">
            <add-to-group group-id="NewGroup" anchor="before" relative-to-action="NewFromTemplate"/>
        </action>
        <group id="Parakeet.InkoManifestToolbar">
            <reference ref="Parakeet.SyncDependencies"/>
        </group>
    </actions>

    <projectListeners>
        <listener class="com.setdef.parakeet.InkoDocIndexFileListener" topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
        <listener class="com.setdef.parakeet.InkoDocIndexWarmer" topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>
</idea-plugin>
