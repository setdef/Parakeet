# Generated by Parakeet for Inko to run tests in the IDE. It lives in the IDE's
# system directory, not your project, and is regenerated for every test run.
import std.env
import std.stdio (Stdout)
import std.test (Filter, Reporter, Test, Tests)
import std.time (Duration)
{{IMPORTS}}

# Reports results as TeamCity service messages, which the IDE's test runner
# reads, with paths mapped from Parakeet's mirror back to the project.
type ParakeetReporter {
  let @out: Stdout
  let @suites: Array[String]
  let mut @failures: Int

  fn escape(value: String) -> String {
    value
      .replace('|', '||')
      .replace("'", "|'")
      .replace('\n', '|n')
      .replace('\r', '|r')
      .replace('[', '|[')
      .replace(']', '|]')
  }

  fn real(path: String) -> String {
    match path.strip_prefix('{{MIRROR}}/') {
      case Some(rest) -> '{{ROOT}}/${rest}'
      case _ -> path
    }
  }

  fn mut message(text: String) {
    @out.print('##teamcity[${text}]').get
    @out.flush.get
  }

  # The suite node for a test's file, announcing it the first time it's seen.
  fn mut suite(test: ref Test) -> String {
    let path = real(test.path.to_string)
    let index = match @suites.index_of(path) {
      case Some(index) -> index
      case _ -> {
        @suites.push(path)

        let index = @suites.size - 1
        let name = path.strip_prefix('{{ROOT}}/test/').or(path)

        message(
          "testSuiteStarted nodeId='s${index}' parentNodeId='0' name='${escape(name)}' locationHint='inko://${escape(path)}'",
        )
        index
      }
    }

    's${index}'
  }

  fn mut started(test: ref Test) -> String {
    let parent = suite(test)
    let id = 't${test.id}'

    message(
      "testStarted nodeId='${id}' parentNodeId='${parent}' name='${escape(test.name)}' locationHint='inko://${escape(real(test.path.to_string))}:${test.line}'",
    )
    id
  }
}

impl Reporter for ParakeetReporter {
  fn pub mut passed(test: Test) {
    let id = started(test)

    message("testFinished nodeId='${id}'")
  }
{{SKIPPED}}
  fn pub mut failed(test: Test) {
    let id = started(test)

    @failures += 1

    for failure in test.failures.iter {
      let location = '${real(failure.path.to_string)}:${failure.line}'

      message(
        "testFailed nodeId='${id}' message='${escape(location)}' expected='${escape(failure.expected)}' actual='${escape(failure.got)}' type='comparisonFailure'",
      )
    }

    message("testFinished nodeId='${id}'")
  }

  fn pub move finished(duration: Duration, seed: Int) -> Bool {
    for index in 0.until(@suites.size) {
      message("testSuiteFinished nodeId='s${index}'")
    }

    @out.print('Seed: ${seed}').get
    @failures == 0
  }
}

type async Main {
  fn async main {
    let tests = Tests.new

{{CALLS}}
    tests.reporter = ParakeetReporter(out: Stdout.new, suites: [], failures: 0) as Reporter
    tests.filter = Filter.from_string(env.arguments.get(0).or(''))
    tests.run
  }
}
