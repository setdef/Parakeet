<idea-plugin>
    <id>com.setdef.parakeet</id>
    <name>Parakeet for Inko</name>
    <vendor email="kerrick@setdef.com" url="https://setdef.com">setdef</vendor>
    <description><![CDATA[
        <p>Parakeet is unofficial, community-made support for the <a href="https://inko-lang.org">Inko</a> programming language.</p>
        <ul>
            <li>Syntax highlighting for <code>.inko</code> files</li>
            <li>Line comment toggling (<code>#</code>)</li>
            <li>Bracket matching, auto-closing pairs, and surrounding pairs</li>
            <li>Compiler errors and warnings as you type, from <code>inko check</code></li>
            <li>Reformat Code (and format on save) with <code>inko fmt</code></li>
            <li>Go to definition, quick documentation, Go to Class/Symbol, and completion, using the definitions <code>inko doc</code> reports</li>
            <li>Structure view, breadcrumbs, and code folding</li>
            <li>Live templates, TODO highlighting, and spell checking</li>
            <li>Run and test from the gutter, with run configurations for <code>inko run</code>, <code>test</code>, <code>build</code>, and <code>check</code></li>
            <li>New Project wizard using <code>inko init</code></li>
            <li>Per-project toolchain: <code>inko</code> on PATH, ivm's default, or any ivm-installed version</li>
        </ul>
        <p>Requires the <code>inko</code> executable, found on <code>PATH</code>, in ivm's install
        directory, or chosen per project in <i>Settings | Languages &amp; Frameworks | Inko</i>.</p>
        <p>Uses the TextMate grammar and language configuration from
        <a href="https://github.com/inko-lang/vscode">inko-lang/vscode</a> (MPL-2.0).
        This plugin is not affiliated with or endorsed by the Inko project.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.textmate</depends>
    <depends optional="true" config-file="parakeet-spellchecker.xml">com.intellij.modules.spellchecker</depends>

    <extensions defaultExtensionNs="com.intellij">
        <textmate.bundleProvider implementation="com.setdef.parakeet.InkoBundleProvider"/>

        <fileType name="Inko" implementationClass="com.setdef.parakeet.InkoFileType" fieldName="INSTANCE"
                  language="Inko" extensions="inko"/>
        <lang.parserDefinition language="Inko" implementationClass="com.setdef.parakeet.InkoParserDefinition"/>
        <!-- Colors come from the Inko TextMate grammar; its tokens need TextMate's editor highlighter too. -->
        <lang.syntaxHighlighterFactory language="Inko"
                                       implementationClass="org.jetbrains.plugins.textmate.language.syntax.highlighting.TextMateSyntaxHighlighterFactory"/>
        <editorHighlighterProvider filetype="Inko"
                                   implementationClass="org.jetbrains.plugins.textmate.language.syntax.highlighting.TextMateEditorHighlighterProvider"/>
        <lang.commenter language="Inko" implementationClass="com.setdef.parakeet.InkoCommenter"/>
        <lang.braceMatcher language="Inko" implementationClass="com.setdef.parakeet.InkoBraceMatcher"/>
        <lang.quoteHandler language="Inko" implementationClass="com.setdef.parakeet.InkoQuoteHandler"/>
        <langCodeStyleSettingsProvider implementation="com.setdef.parakeet.InkoCodeStyleSettingsProvider"/>
        <lineIndentProvider implementation="com.setdef.parakeet.InkoLineIndentProvider"/>
        <typedHandler implementation="com.setdef.parakeet.InkoClosingBracketTypedHandler"/>
        <lang.psiStructureViewFactory language="Inko" implementationClass="com.setdef.parakeet.InkoStructureViewFactory"/>
        <breadcrumbsInfoProvider implementation="com.setdef.parakeet.InkoBreadcrumbsProvider"/>
        <lang.foldingBuilder language="Inko" implementationClass="com.setdef.parakeet.InkoFoldingBuilder"/>
        <completion.contributor language="Inko" implementationClass="com.setdef.parakeet.InkoCompletionContributor"/>
        <typedHandler implementation="com.setdef.parakeet.InkoCompletionAutoPopup"/>
        <liveTemplateContext contextId="INKO" implementation="com.setdef.parakeet.InkoTemplateContextType"/>
        <defaultLiveTemplates file="/liveTemplates/Inko.xml"/>
        <indexPatternBuilder implementation="com.setdef.parakeet.InkoIndexPatternBuilder"/>
        <todoIndexer filetype="Inko" implementationClass="com.setdef.parakeet.InkoTodoIndexer"/>

        <projectService serviceInterface="com.setdef.parakeet.InkoCli" serviceImplementation="com.setdef.parakeet.InkoProjectCli"/>
        <applicationService serviceInterface="com.setdef.parakeet.IvmCli" serviceImplementation="com.setdef.parakeet.IvmProcessCli"/>
        <editorNotificationProvider implementation="com.setdef.parakeet.InkoMissingBanner"/>
        <editorNotificationProvider implementation="com.setdef.parakeet.InkoRequiredVersionBanner"/>

        <externalAnnotator language="Inko" implementationClass="com.setdef.parakeet.InkoCheckAnnotator"/>
        <formattingService implementation="com.setdef.parakeet.InkoFormattingService"/>
        <platform.backend.documentation.psiTargetProvider implementation="com.setdef.parakeet.InkoDocumentationTargetProvider"/>
        <gotoClassContributor implementation="com.setdef.parakeet.InkoGotoClassContributor"/>
        <gotoSymbolContributor implementation="com.setdef.parakeet.InkoGotoSymbolContributor"/>
        <postStartupActivity implementation="com.setdef.parakeet.InkoIndexOnStartup"/>

        <configurationType implementation="com.setdef.parakeet.InkoRunConfigurationType"/>
        <runConfigurationProducer implementation="com.setdef.parakeet.InkoRunConfigurationProducer"/>
        <codeInsight.parameterInfo language="Inko" implementationClass="com.setdef.parakeet.InkoParameterInfoHandler"/>
        <codeInsight.lineMarkerProvider language="Inko" implementationClass="com.setdef.parakeet.InkoTraitLineMarkerProvider"/>
        <runLineMarkerContributor language="Inko" implementationClass="com.setdef.parakeet.InkoRunLineMarkerContributor"/>

        <newProjectWizard.generator implementation="com.setdef.parakeet.InkoNewProjectWizard"/>
        <directoryProjectGenerator implementation="com.setdef.parakeet.InkoDirectoryProjectGenerator"/>

        <notificationGroup id="Parakeet for Inko" displayType="BALLOON"/>
        <projectConfigurable parentId="language" id="com.setdef.parakeet.settings" displayName="Inko"
                             instance="com.setdef.parakeet.InkoConfigurable"/>
    </extensions>

    <projectListeners>
        <listener class="com.setdef.parakeet.InkoDocIndexFileListener" topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
        <listener class="com.setdef.parakeet.InkoDocIndexWarmer" topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>
</idea-plugin>
